{
  "name": "tossmap-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true},
  "vars": {"X402_NETWORK": "eip155:84532", "PAY_TO_ADDRESS": "", "FACILITATOR_URL": ""},
  "durable_objects": {"bindings": [{"name": "STATE", "class_name": "State"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["State"]}],
  "ratelimits": [{"name": "GENERAL_LIMIT", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}}, {"name": "CHALLENGE_LIMIT", "namespace_id": "1002", "simple": {"limit": 20, "period": 60}}]
}
